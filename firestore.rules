rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function supportAdmin() {
      return signedIn() && request.auth.uid in [
        'TIat7e3WQyXIk9HyLdjPxsfZ6R92',
        'B23E8GVKHIUnzgdK5YScoiZzsnG3'
      ];
    }

    function validSupportStatus(status) {
      return status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.uid == userId;
      allow update: if ownsUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsUser(userId);

      match /library/{itemId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll([
            'id', 'provider', 'kind', 'title', 'sourceUrl', 'libraryStatus'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'provider', 'kind', 'title', 'alternateTitle',
            'description', 'cover', 'year', 'status', 'ageRating',
            'originalLanguage', 'subtype', 'sourceUrl', 'chapters',
            'anilistId', 'anilistUrl', 'anilistTitle', 'anilistScore', 'anilistGenres',
            'libraryStatus', 'updatedAt'
          ])
          && (!request.resource.data.keys().hasAny(['anilistId'])
            || (request.resource.data.anilistId is int && request.resource.data.anilistId > 0))
          && (!request.resource.data.keys().hasAny(['anilistUrl'])
            || (request.resource.data.anilistUrl is string && request.resource.data.anilistUrl.size() <= 300))
          && (!request.resource.data.keys().hasAny(['anilistTitle'])
            || (request.resource.data.anilistTitle is string && request.resource.data.anilistTitle.size() <= 200))
          && (!request.resource.data.keys().hasAny(['anilistScore'])
            || (request.resource.data.anilistScore is int && request.resource.data.anilistScore >= 0 && request.resource.data.anilistScore <= 100))
          && (!request.resource.data.keys().hasAny(['anilistGenres'])
            || (request.resource.data.anilistGenres is list && request.resource.data.anilistGenres.size() <= 5))
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 160
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.provider == 'mangadex'
          && request.resource.data.kind in ['manga', 'manhwa']
          && request.resource.data.sourceUrl is string
          && request.resource.data.libraryStatus in [
            'to_read', 'reading', 'completed', 'paused', 'dropped'
          ];
      }
    }

    match /supportTickets/{ticketId} {
      allow get, list: if supportAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'email', 'subject', 'category', 'status',
          'lastMessagePreview', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'subject', 'category', 'status',
          'lastMessagePreview', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 120
        && request.resource.data.category in [
          'bug', 'account', 'reading', 'catalog', 'suggestion', 'other'
        ]
        && request.resource.data.status == 'open'
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 180
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if supportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'
        ])
        && validSupportStatus(request.resource.data.status)
        && request.resource.data.updatedAt is timestamp
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'
          ])
          && request.resource.data.updatedAt is timestamp
          && (request.resource.data.status == resource.data.status
            || request.resource.data.status in ['open', 'resolved']));

      allow delete: if supportAdmin();

      match /messages/{messageId} {
        allow get, list: if supportAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'authorUid', 'authorName', 'authorRole', 'body', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'authorRole', 'body', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.authorRole == (supportAdmin() ? 'support' : 'user')
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt is timestamp
          && (supportAdmin()
            || get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);

        allow update, delete: if false;
      }
    }
  }
}
