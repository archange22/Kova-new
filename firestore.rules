rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.uid == userId;
      allow update: if ownsUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsUser(userId);

      match /library/{itemId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll([
            'id', 'provider', 'kind', 'title', 'sourceUrl', 'libraryStatus'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'provider', 'kind', 'title', 'alternateTitle',
            'description', 'cover', 'year', 'status', 'rating',
            'ageRating', 'subtype', 'sourceUrl', 'chapters', 'libraryStatus', 'updatedAt'
          ])
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 160
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.provider in ['kitsu', 'openlibrary', 'kova', 'mangadex']
          && request.resource.data.kind in ['manga', 'manhwa', 'comics']
          && request.resource.data.sourceUrl is string
          && request.resource.data.libraryStatus in [
            'to_read', 'reading', 'completed', 'paused', 'dropped'
          ];
      }
    }
  }
}
