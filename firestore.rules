rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'fL5Gz1lTOUY11JRu14KHKcDD95q1';
    }

    function supportAdmin() {
      return isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner']);
    }

    function validSupportStatus(status) {
      return status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    match /users/{userId} {
      // Private account document: only its owner and the site owner can read it.
      allow get: if ownsUser(userId) || isOwner();
      allow list: if isOwner();

      // The app creates the account document automatically after authentication.
      // A member may only create a normal account for their own Auth UID.
      allow create: if ownsUser(userId)
        && request.resource.data.uid == userId
        && (
          request.resource.data.role == 'user'
          || (isOwner() && request.resource.data.role == 'owner')
        )
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 320000
        && request.resource.data.bannerURL is string
        && request.resource.data.bannerURL.size() <= 320000;

      // Members may update profile fields, but never change their own role or UID.
      // Legacy documents without uid can be repaired by their authenticated owner.
      allow update: if (
        ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'username', 'bio', 'photoURL', 'bannerURL', 'email', 'updatedAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 320000
        && request.resource.data.bannerURL is string
        && request.resource.data.bannerURL.size() <= 320000
      ) || (
        isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['user', 'admin', 'owner']
      );

      // Self-service account deletion. Admin/owner promotion remains owner-only.
      allow delete: if ownsUser(userId);

      match /library/{itemId} {
        allow read, delete: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasAll([
            'id', 'provider', 'kind', 'title', 'sourceUrl', 'libraryStatus'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'provider', 'kind', 'title', 'alternateTitle',
            'description', 'cover', 'year', 'status', 'ageRating',
            'originalLanguage', 'subtype', 'sourceUrl', 'chapters',
            'anilistId', 'anilistUrl', 'anilistTitle', 'anilistScore', 'anilistGenres',
            'libraryStatus', 'updatedAt'
          ])
          && (!request.resource.data.keys().hasAny(['anilistId'])
            || (request.resource.data.anilistId is int && request.resource.data.anilistId > 0))
          && (!request.resource.data.keys().hasAny(['anilistUrl'])
            || (request.resource.data.anilistUrl is string && request.resource.data.anilistUrl.size() <= 300))
          && (!request.resource.data.keys().hasAny(['anilistTitle'])
            || (request.resource.data.anilistTitle is string && request.resource.data.anilistTitle.size() <= 200))
          && (!request.resource.data.keys().hasAny(['anilistScore'])
            || (request.resource.data.anilistScore is int && request.resource.data.anilistScore >= 0 && request.resource.data.anilistScore <= 100))
          && (!request.resource.data.keys().hasAny(['anilistGenres'])
            || (request.resource.data.anilistGenres is list && request.resource.data.anilistGenres.size() <= 5))
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 160
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.provider in ['mangadex', 'local']
          && request.resource.data.kind in ['manga', 'manhwa']
          && request.resource.data.sourceUrl is string
          && request.resource.data.libraryStatus in [
            'to_read', 'reading', 'completed', 'paused', 'dropped'
          ];
      }
    }

    // Public member cards contain only fields intended for public display.
    // Private account data remains isolated in /users/{userId}.
    match /publicProfiles/{userId} {
      allow get, list: if true;
      allow create: if ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'bio', 'photoURL', 'bannerURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 320000
        && request.resource.data.bannerURL is string
        && request.resource.data.bannerURL.size() <= 320000;
      allow update: if ownsUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'bio', 'photoURL', 'bannerURL', 'updatedAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 320000
        && request.resource.data.bannerURL is string
        && request.resource.data.bannerURL.size() <= 320000;
      allow delete: if ownsUser(userId);
    }

    // Follow edges are public for counts, but only the follower can create/remove their edge.
    match /follows/{followId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['followerUid', 'followingUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingUid
        && request.resource.data.createdAt is timestamp;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /supportTickets/{ticketId} {
      allow get, list: if supportAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'email', 'subject', 'category', 'status',
          'lastMessagePreview', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'subject', 'category', 'status',
          'lastMessagePreview', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 120
        && request.resource.data.category in [
          'bug', 'account', 'reading', 'catalog', 'suggestion', 'other'
        ]
        && request.resource.data.status == 'open'
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 180
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if (
        supportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'
        ])
        && validSupportStatus(request.resource.data.status)
        && request.resource.data.updatedAt is timestamp
      ) || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'
        ])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 180
        && (request.resource.data.status == resource.data.status
          || request.resource.data.status in ['open', 'resolved'])
      );

      allow delete: if supportAdmin();

      match /messages/{messageId} {
        allow get, list: if supportAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'authorUid', 'authorName', 'authorRole', 'body', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'authorRole', 'body', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.authorRole == (supportAdmin() ? 'support' : 'user')
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt is timestamp
          && (supportAdmin()
            || getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);

        allow update, delete: if false;
      }
    }
  }
}
